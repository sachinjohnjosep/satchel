# Copy to .env.local for local development, and add the same names in Vercel →
# Project → Settings → Environment Variables. Only NEXT_PUBLIC_* values reach the browser.

# ── Supabase (Project Settings → API Keys / Data API) ─────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "publishable" key (sb_publishable_…). Older projects: the "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key (sb_secret_…), or the legacy service_role key. SERVER ONLY. Never share it.
SUPABASE_SECRET_KEY=

# ── Site ──────────────────────────────────────────────────────────
# Your public address, used in canonical links, the sitemap and emails.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# ── Spam protection for "Leave a note" (Cloudflare Turnstile) ─────
# Required in production: without it, notes are refused (fail closed).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Any long random string. Salts the one-way hash used for rate limiting.
RATE_LIMIT_SALT=

# ── Optional: email when a note arrives (Resend) ──────────────────
RESEND_API_KEY=
# Sender, e.g. "Satchel <onboarding@resend.dev>" until you verify your own domain.
NOTIFY_FROM=
# Fallback recipient if none is set in Dashboard → Settings.
NOTIFY_EMAIL=

# ── Optional: daily keep-alive (Vercel Cron) ──────────────────────
# Any long random string. Vercel sends it to /api/keepalive.
CRON_SECRET=
